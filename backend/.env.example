PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=reeftales_db

JWT_SECRET=change_me_to_a_long_random_secret
GEMINI_API_KEY=your_gemini_api_key

# Public frontend origin used in password reset links.
# Example: https://your-frontend.vercel.app
FRONTEND_URL=

# Optional demo fallback. Keep false for real production email flows.
# When true, the forgot-password API returns resetLink if SMTP is unavailable.
RETURN_PASSWORD_RESET_LINK=false

# Optional SMTP settings for password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Keep false locally unless you want local uploads to use Cloudinary too.
USE_CLOUDINARY=false

# Required only when USE_CLOUDINARY=true or when running seed image upload scripts.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional fallback for seed images that are not present in the generated JSON files.
# Usually leave this blank because seedIslandImages.generated.json and
# seedSpeciesImages.generated.json already contain Cloudinary URLs.
SEED_IMAGE_BASE_URL=
